# PHOBO_CAMERA_MODE options: mock | command | eos-watch | browser-video | digicam-live
PHOBO_CAMERA_MODE=browser-video
PHOBO_CAMERA_CAPTURE_MODE=digicamcontrol
PHOBO_DIGICAM_BASE_URL=http://127.0.0.1:5513
PHOBO_CAMERA_CAPTURE_DIR=C:\PhoboCameraCaptures
PHOBO_CAMERA_CAPTURE_TIMEOUT_MS=20000

# Camera Customer Live Preview Toggle:
# PHOBO_CAMERA_PREVIEW_ENABLED=true  -> Normal customer live preview (browser-video / HDMI)
# PHOBO_CAMERA_PREVIEW_ENABLED=false -> Emergency fallback (shows "MOHON LIHAT KE LENSA KAMERA" placeholder without initializing HDMI stream)
# NOTE: This setting affects ONLY customer screen preview, NOT DSLR capture. Capture always uses real Canon DSLR JPEG.
PHOBO_CAMERA_PREVIEW_ENABLED=true

PHOBO_CAMERA_COMMAND_PATH=
PHOBO_CAMERA_COMMAND_ARGS_TEMPLATE=/filename "{output}" /capture

# Printer Configuration
PHOBO_PRINTER_MODE=mock
PHOBO_PRINTER_NAME=Canon SELPHY CP1500
PHOBO_PRINT_COMMAND_MODE=direct-dotnet
PHOBO_PRINT_DRY_RUN=false
PHOBO_PRINT_PAPER=4R
PHOBO_PRINT_WIDTH_PX=1181
PHOBO_PRINT_HEIGHT_PX=1748
PHOBO_PRINT_FIT=fill

# Storage & Google Drive Configuration
PHOBO_STORAGE_MODE=local
PHOBO_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
PHOBO_RESULTS_DIR=public/results

PHOBO_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Integration (options: operator | midtrans | mock)
# Event standard: static merchant QRIS + exact base nominal + manual operator confirmation
PHOBO_PAYMENT_PROVIDER=operator
PHOBO_OPERATOR_PAYMENT_ENABLED=true
PHOBO_OPERATOR_QRIS_IMAGE=/assets/payment/qris.png
PHOBO_OPERATOR_PIN=8888

MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

NEXT_PUBLIC_CAMERA_DEBUG=false
NEXT_PUBLIC_PAYMENT_DEBUG=false
PHOBO_DEBUG_LOGS=false
